# Server only. Never prefix secrets with VITE_.
MONGODB_URI=
ZOHO_FLOW_WEBHOOK_URL=
# Legacy OAuth only: unused by enquiry submission and zoho:retry.
# Retained for explicit rollback / zoho:test / optional legacy metadata helpers.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# HTTPS origins for your account data center, without /crm/v8. Trailing slash is accepted.
# Run npm run zoho:test privately to validate OAuth and read access.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com
ZOHO_LEADS_MODULE=Leads
# Optional additional frontend origin; same-origin works without this.
ALLOWED_ORIGIN=
# Public build-time setting: confirmed international digits, no + or spaces.
VITE_CLINIC_WHATSAPP_NUMBER=
# Legacy direct-CRM mappings only. Configure current CRM mapping inside Zoho Flow.
ZOHO_FIELD_SERVICE=
ZOHO_FIELD_UTM_SOURCE=
ZOHO_FIELD_UTM_MEDIUM=
ZOHO_FIELD_UTM_CAMPAIGN=
ZOHO_FIELD_UTM_CONTENT=
ZOHO_FIELD_UTM_TERM=
ZOHO_FIELD_LANDING_PAGE=
ZOHO_FIELD_REFERRER=
# Only set to an existing Lead_Status picklist value.
ZOHO_LEAD_STATUS=

# Server-only BotSpace settings. Contact creation is account-scoped.
BOTSPACE_API_KEY=
BOTSPACE_CHANNEL_ID=6ac529a17669b2ff0c3bd3d2
BOTSPACE_BASE_URL=https://public-api.bot.space
BOTSPACE_TEMPLATE_ID=
# Reserved safety switch: form submission never sends messages, even if set true.
BOTSPACE_AUTO_SEND=false
# Reserved only; unused until BotSpace documents webhook verification.
BOTSPACE_WEBHOOK_SECRET=
# Optional real Zoho API field names; copy from your CRM metadata.
ZOHO_FIELD_WHATSAPP_STATUS=
ZOHO_FIELD_BOTSPACE_CONTACT_ID=
ZOHO_FIELD_BOTSPACE_CONVERSATION_ID=
ZOHO_FIELD_LAST_WHATSAPP_MESSAGE_AT=
ZOHO_FIELD_LAST_WHATSAPP_DIRECTION=
